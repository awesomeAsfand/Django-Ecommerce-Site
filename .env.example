# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://shop.example.com (required in production behind HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=
# host port for the dev server (http://localhost:WEB_PORT)
WEB_PORT=8000

# PostgreSQL (POSTGRES_HOST is set by docker compose)
POSTGRES_DB=myshop
POSTGRES_USER=myshop
POSTGRES_PASSWORD=myshop

# Stripe - test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# printed by `docker compose --profile stripe up` (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (production only; dev uses Mailpit automatically)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=shop@example.com
